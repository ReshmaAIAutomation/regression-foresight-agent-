# 🚀 Regression Foresight Agent - Environment Variables Template
# Copy this file to a new file named '.env' and fill in your credentials.

# GitHub Configuration
# Generate a Personal Access Token (PAT) with 'public_repo' scope.
GITHUB_TOKEN="your_github_personal_access_token_here"

# Jira Cloud Configuration
# Your Atlassian domain (e.g., https://your-domain.atlassian.net) and login email
JIRA_DOMAIN="https://your-domain.atlassian.net"
JIRA_EMAIL="your_email@example.com"
JIRA_API_TOKEN="your_atlassian_api_token_here"

# RAG GenAI Configuration
# MongoDB Atlas Connection URI and API keys for embeddings & reranking
MONGO_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<app>"
MISTRAL_API_KEY="your_mistral_api_key_here"
GROQ_API_KEY="your_groq_api_key_here"

# Operational Mode
# Set to 'false' to enable live JIRA/GitHub API connections, or 'true' to use local mock data.
OFFLINE_MODE="false"
